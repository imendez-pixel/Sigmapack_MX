					)
				}
			}
		}
		form New_Opportunity
		{
			title
    		{
    			displayname = "Nueva Oportunidad"
    			on add = "New Opportunity"
   	 			on edit = "Edit Opportunity"
			}
			success message = "Data Added Successfully!"
			feature property = 576
			Section4
			(
				type = section
				displayname = "Section"
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><span class=\"font\" style=\"font-family: Arimo, sans-serif\"><b><span class=\"size\" style=\"font-size: 18.6667px\"><span class=\"colour\" style=\"color: rgb(255, 51, 51)\">Opportunity Information</span></span></b></span><br /></div>"
	 			row = 1
	 			column = 1   
