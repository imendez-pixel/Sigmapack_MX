		workflow
		{
		form
		{
			Agregar_Formatos3 as "Agregar Formatos"
			{
				type =  form
				form = Labelling_formats

				record event = on add or edit

				field rules
				{
				}

			}
			AgregarProduct_Specs as "AgregarProduct Specs"
			{
				type =  form
				form = Opportunity_Requirements

				record event = on add or edit
					status = inactive

				field rules
				{
				}

			}
			Agregar_Formatos5 as "Agregar Formatos"
			{
				type =  form
				form = Opportunity_Formats_Sizes

				record event = on add or edit

				field rules
				{
				}

			}
			Create_ID as "Create ID"
			{
				type =  form
				form = New_Opportunity

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											oppRecord = New_Opportunity[ID == input.ID];
										oppRecord.Opportunity_ID2=input.ID;
										DisplayName = oppRecord.Opportunity_ID2.toString();
										oppRecord.Opportunity_ID_Text="<b><span style='font-size:14px; color:#C0392B;'>" + DisplayName + "</span></b>";
						)
					}
				}

			}
			Productos_Al_Cargar as "Productos - Al cargar"
			{
				type =  form
				form = Opportunity_Products

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											if(input.New_Opportunity != null)
											{
												total = Opportunity_Products[New_Opportunity == input.New_Opportunity].count();
												opp = New_Opportunity[ID == input.New_Opportunity];
												input.Productos_registrados = "<div><span style='color:#5D6D7E;'><b>Oportunidad " + opp.Opportunity_ID2 + "</b>: " + total + " producto(s) registrado(s). Este producto será la partida #" + (total + 1) + ".</span></div>";
											}
											else
											{
												input.Productos_registrados = "<div><span style='color:#5D6D7E;'>Selecciona la oportunidad. Marca <b>Agregar otro producto</b> al final para capturar varias partidas seguidas.</span></div>";
											}
						)
					}
				}

			}
			Productos_Bloquear_Partida as "Productos - Bloquear partida"
			{
				type =  form
				form = Opportunity_Products

				record event = on add or edit

				field rules
				{
					actions 
					{
						disable Partida_Oportunidad;
					}
				}

			}
			Productos_Numerar_Partida as "Productos - Numerar partida"
			{
				type =  form
				form = Opportunity_Products

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											input.Partida_Oportunidad = Opportunity_Products[New_Opportunity == input.New_Opportunity].count() + 1;
						)
					}
				}

			}
			Productos_Agregar_Otro as "Productos - Agregar otro"
			{
				type =  form
				form = Opportunity_Products

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.Agregar_otro_producto == true && input.New_Opportunity != null)
											{
												rec = Opportunity_Products[ID == input.ID];
												rec.Agregar_otro_producto = false;
												openUrl("#Form:Opportunity_Products?New_Opportunity=" + input.New_Opportunity + "&Agregar_otro_producto=true","same window");
											}
						)
					}
				}

			}
			Hide_ID as "Hide ID"
			{
				type =  form
				form = New_Opportunity

				record event = on add or edit

				field rules
				{
					actions 
					{
						hide Opportunity_ID2;
					}
					actions 
					{
						disable Opportunity_ID_Text;
					}
				}

			}
		}




