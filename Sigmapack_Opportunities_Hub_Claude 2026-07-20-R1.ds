					(
   						type = submit
   						displayname = "Save"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form New_Project_Form
		{
			displayname = "New Project Form"
			success message = "Data Added Successfully!"
			Section2
			(
				type = section
				displayname = "Section"
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain2
			(
    			type = plaintext
				value = "<div><span class=\"size\" style=\"font-size: 16px\"><span class=\"font\" style=\"font-family: Arimo, sans-serif\"><span class=\"colour\" style=\"color: rgb(255, 51, 51)\"><b>Project Details</b></span></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			New_Project
			(
				type = section
				displayname = "New Project"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Project_ID1
			(
    			type = autonumber
				displayname = "Project_ID"
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Reference_Description
			(
    			type = text
				displayname = "Reference/Description"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Lead_Company
			(
				type = list	
				displayname = "Add Client Company"
				values  = Lead_Company.ID
    			displayformat = [" " + Name.first_name + " " + Name.last_name]
				sortorder = ascending
				height = 60px
	 			row = 2
	 			column = 3   
				width = medium
			)
			Client_Site
			(
				type = picklist	
				displayname = "Client Site"
				values  = Client_Sites.ID
    			displayformat = [Site_ID + " - " + site_name + " - " + address.state_province + " - " + address.country]
				sortorder = ascending
	 			row = 2
	 			column = 3   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 3
	 			column = 0   
				width = medium
			)
			unique Project_ID
			(
    			type = text
				displayname = "Project_reference"
				initial value = "PRJ-2026-001"
	 			row = 3
	 			column = 1   
				width = medium
			)
			plain1
			(
    			type = plaintext
				value = "<div> <span class=\"font\" style=\"font-family: Arimo, sans-serif\"><span class=\"size\" style=\"font-size: 16px\"><span class=\"colour\" style=\"color: rgb(255, 51, 51)\"><b>Project descriiption</b></span></span></span></div>"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Description
			(
				type = section
	 			row = 4
	 			column = 0   
				width = medium
			)
			Project_Description
			(
    			type = richtext
				displayname = "Project Description"
				height = 250px
				toolbar = enable
				[
					style, font-color, background-color, remove-formatting, alignment, link, table, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 4
	 			column = 1   
				width = large
			)
			Section
			(
				type = section
	 			row = 5
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div> <span class=\"size\" style=\"font-size: 16px\"><span class=\"colour\" style=\"color: rgb(255, 51, 51)\"><b>Project Files</b></span></span></div>"
	 			row = 5
	 			column = 1   
				width = medium
			)
			File_upload
			(
    			type = upload file
				displayname = "File upload"
    			file count = 10
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
	
			actions
