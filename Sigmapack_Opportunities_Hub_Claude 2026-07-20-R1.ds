			Viscosity_cP
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Flash_Point_C
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Hazardous_Area_Zone
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Dissolved_Oxygen_Max_ppb
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Total_Package_Oxygen_Max_ppb
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Inert_Gas_Type
			(
    			type = text
				initial value = "CO₂"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pre_Evacuation_Required
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pasteurization_Required
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			Closure_Application
			(
    			type = text
				initial value = "Corona"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tax_Stamp_Required
			(
    			type = checkbox
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
