				allow new entries
				[
					displayname = "Agregar nuevo"
				]
				sortorder = ascending
	 			row = 3
	 			column = 2   
				width = medium
			)
			Probability_of_getting_the_Order
			(
				type = picklist
				displayname = "Probability of getting the Order"
				maxchar = 100
				values = {"⏩Seems very good","▶️ Seems Good","⏯️ Seems Fair","◀️ Seems Bad"}
	 			row = 3
	 			column = 3   
				width = medium
			)
			Contact_Engagement
			(
				type = picklist
				displayname = "Contact Engagement"
				maxchar = 100
				values = {"⭐⭐⭐⭐⭐ (5) Confirmed budget and choice","⭐⭐⭐⭐ (4)  Internal Advocate","⭐⭐⭐ (3) Engaged: Replies on time / Asks questions","⭐⭐ (2) Lukewarm: No urgency .Grey area","⭐ (1) Ghosting: Stopped replying","❌(0) New contact/ Inactivity limit reached"}
	 			row = 3
	 			column = 3   
				width = medium
			)
			Deal_Stage
			(
				type = picklist
				displayname = "Deal Stage"
				maxchar = 100
				values = {"⬜⬜⬜⬜☑️B.A.N.T Analysis |Technical specs","⬜⬜⬜☑️☑️Solutⁿ design | Budget quotⁿ Drafting","⬜⬜☑️☑️☑️Evaluatⁿ | OEE-ROI Evidencing | Requoting","⬜☑️☑️☑️☑️Final quote confirmed receipt | chasing feedback","☑️☑️☑️☑️☑️Negotⁿ and Decision stage."}
	 			row = 3
	 			column = 3   
				width = medium
			)
			Status
			(
				type = picklist
				displayname = "Status | Priority"
