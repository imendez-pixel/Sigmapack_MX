 application "Sigmapack Opportunities Hub 2"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Bahia_Banderas"
 	time format = "24-hr"

 	forms
	{
		form Lead_Company
		{
			displayname = "Add Client Company"
			success message = "New Lead Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Client_ID
			(
    			type = autonumber
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Company_name
			(
    			type = text
				displayname = "Company name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Industry
			(
				type = picklist
				maxchar = 100
				values = {"Pharma & Nutraceuticals","Cosmetics & Personal Care","Chemicals & Household","Food & Beverages"}
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Website
			(
    			type = url
	 			row = 1
	 			column = 2   
				width = medium
			)
			Employee_Count
			(
				type = picklist
				displayname = "Employee Count"
				values = {"< 100","100 - 500","500 - 1000","1000 - 10000","> 10000"}
	 			row = 1
	 			column = 3   
				width = medium
			)
			Contacts
			(
				type = section
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
			)
			Job_Title
			(
    			type = text
				displayname = "Job Title"
	 			row = 2
	 			column = 2   
				width = medium
			)
			Opportunity_Role
			(
				type = picklist
				displayname = "Opportunity Role"
				maxchar = 100
				values = {"Technical Influencer","Leading Actor","Ownership"}
				sortorder = ascending
	 			row = 2
	 			column = 2   
				width = medium
			)
			Mobile_Number
			(
    			type = phonenumber
				displayname = "Mobile Number"
	 			row = 2
	 			column = 3   
				width = medium
			)
			must have Email_Id
			(
    			type = email
				displayname = "Email Id"
				maxchar = 253
	 			row = 2
	 			column = 3   
				width = medium
			)
			Sitios
			(
				type = grid
				displayname = "Sites"
				values  = Client_Sites.ID
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Save
					(
   						type = submit
   						displayname = "Save"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Client_Sites
		{
			displayname = "Add Client Site"
			success message = "Data Added Successfully!"
			Contacts
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain1
			(
    			type = plaintext
				value = "<div><span class=\"size\" style=\"font-size: 16px\"><span class=\"colour\" style=\"color: rgb(255, 51, 51)\"><b>Company Site Information</b></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			New_Site
			(
				type = section
				displayname = "New Site"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Site_ID
			(
    			type = autonumber
				start index = 1
	 			row = 2
	 			column = 1   
				width = medium
			)
			Lookup_Client_Company
			(
				type = picklist	
				displayname = "Lookup Client Company"
				values  = Lead_Company.ID
    			displayformat = [Client_ID + " - " + Company_name + " - " + Name.first_name + " - " + Name.last_name]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			site_name
			(
    			type = text
				displayname = "Site Name"
				initial value = "Main Site"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Contact
			(
				type = picklist	
				values  = Lead_Company.ID
    			displayformat = [" " + Name.first_name + " " + Name.last_name + " " + Email_Id]
				allow new entries
				[
					displayname = "Agregar nuevo"
				]
				sortorder = ascending
	 			row = 2
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = true
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 2   
				width = medium
				personal data = true
			)
			Section
			(
				type = section
	 			row = 3
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><span class=\"size\" style=\"font-size: 16px\"><b><span class=\"font\" style=\"font-family: Arimo, sans-serif\"><span class=\"colour\" style=\"color: rgb(255, 51, 51)\">CAD Equipment &amp; Areas layouts</span></span></b></span><br /></div>"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 4
	 			column = 0   
				width = medium
			)
			File_upload
			(
    			type = upload file
				displayname = "File upload"
    			file count = 10
				browse = local_drive, zoho_docs
	 			row = 4
	 			column = 1
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
	 			row = 5
	 			column = 0   
				width = medium
			)
	
			actions
			{
				on add
				{
					Save
					(
   						type = submit
   						displayname = "Save"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Add_Partner_companies
		{
			displayname = "Add Partner Company"
			success message = "Data Added Successfully!"
