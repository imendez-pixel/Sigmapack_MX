	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			Machinery_range
			(
				type = list	
				displayname = "Machinery range"
				values = {"Depaletizing","Unscrambler","Feeding table","Cleaning","Air Driyinng","Dosing / Filling","Tabletting","Counting","Capsule filling","Dosing /Filling /Capping","Cleaning/Filling/Capping","Closing/Capping/Torquing","Plugging/ Inserting","Labelling","Grouping","Cartoning","Tray forming","Blistering","Bundling/ banding","Overwrapping","Case forming","Casepacking","Palletizing","Mixing","Cooking","Drying","Freezedrying","Autoclave","Pasteurizing","Carbonator","Emulsifying"}
				height = 13px
	 			row = 1
	 			column = 2   
				width = medium
			)
			Phone
			(
    			type = text
	 			row = 1
	 			column = 2   
				width = medium
			)
			Partner_Website
			(
    			type = url
				displayname = "Website"
				enable  linkname
	 			row = 1
	 			column = 3   
				width = medium
			)
			Partner_contacts
			(
				type = section
				displayname = "Partner contacts"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Sales_Contact
			(
    			type = name
				displayname = "Sales Contact"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Email
			(
    			type = email
	 			row = 2
	 			column = 2   
				width = medium
			)
			Phone_Number
			(
    			type = phonenumber
				displayname = "Phone"
	 			row = 2
	 			column = 3   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					Save1
					(
   						type = submit
   						displayname = "Save"
					)
