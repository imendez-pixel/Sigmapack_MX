				values = {"Moulded pulp","PET","rPET","HDPE / PEAD","LDPE / PEBD","PP","PVC","PS","PLA","BOPP","PET/PE laminate","Aluminum laminate","Paper","Paper-Laminate","Glass","Aluminium","Tin","Steel"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Other_Features
			(
    			type = text
				displayname = "Other Features "
				initial value = "Zipper, Valve, etc."
	 			row = 1
	 			column = 1   
				width = medium
			)
			D_Diameter_mm
			(
				type = number
				displayname = "D - Diameter (mm)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Neck_Diameter_mm
			(
				type = number
				displayname = "Neck Diameter(mm)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			L_Lenght_mm
			(
				type = number
				displayname = "L- Lenght (mm)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			b_Width_mm
			(
				type = number
				displayname = "W - Width (mm)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			H_Heigth_mm
			(
				type = number
				displayname = "H - Heigth (mm)"
	 			row = 1
	 			column = 2   
				width = medium
			)
			Files_upload
			(
    			type = upload file
				displayname = "Files upload"
    			file count = 10
				browse = local_drive, zoho_docs
	 			row = 1
	 			column = 2   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list All_Opportunity_Comments
		{
			displayName = "All Opportunity Comments"
			show all rows from Opportunity_Comments    
			(
				Comment_Date_Time as "Comment Date Time"
				Attachments
				Comments
				Opportunity
				Subject_field as "Subject"
				Opportunity.Opportunity_ID1 as "Opportunity ID"
				Opportunity.opportunity_owner as "Opportunity Owner"
				Opportunity.Client_Company
				Opportunity.Partner_Company as "Partner Company"
			)
			sort by
			(
				Comment_Date_Time descending
			)
		}
		list Sales_Leads_Co
		{
			displayName = "View Client Companies"
			show all rows from Lead_Company    
			(
				Website
				Employee_Count as "Employee Count"
				Company_name as "Company name"
				Sitios as "Sites"
				(
					field = Sitios.Lead_Company + " " + Sitios.site_name + " " + Sitios.address
				)
				Contacts
				(
					field = Contacts.Name + " " + Contacts.Mobile_Number
				)
			)
			group by
			(
				Company_name ascending
			)
		}
		list Partner_companies_Report
		{
			displayName = "View Partners"
			show all rows from Add_Partner_companies    
			(
				Machinery_range as "Machinery range"
				Partner_Company_name as "Partner Company name"
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Phone
			)
		}
		default list Projects_Report
		{
			displayName = "View Multi Op. Projects"
			show all rows from New_Project_Form    
			(
				Project_Description as "Project Description"
				File_upload as "File upload"
				Project_ID as "Project_reference"
				Project_ID1 as "Project_ID"
				Reference_Description as "Reference/Description"
				Opportunity_Nr as "Opportunity Nr."
			)
		}
		list TPL_Non_Carbonated_Report
		{
			displayName = "TPL_Non_Carbonated Report"
			show all rows from TPL_No_Carbonatadas    
			(
				Product_Temp_Fill_C
				Brix_deg
				pH
				Viscosity_Max_cP
				Pulp_Content_pct
				Particle_Size_Max_mm
				Foaming_Level
				Aseptic_Required
				UHT_Upstream
				Nitrogen_Dosing
				Preservatives_Used as "Preservatives"
				Product_Contact_Material
			)
		}
		default list Settings_Report
		{
			displayName = "Settings Reporte"
			show all rows from Settings    
			(
				theme_preference as "Theme Preference"
				language_preference as "Language Preference"
				enable_email_tracking as "Enable Email Tracking"
			)
		}
		default list TPL_Secondary_packaging_Report
		{
			displayName = "TPL_Secondary packaging Reporte"
			show all rows from TPL_Secondary_packaging    
			(
				Named as "Product Name"
				Secondary_packaging_type as "Primary material"
				Packaging_Type as "Secondary Packaging type"
				a_Lenght_mm as "a- Lenght (mm)"
				b_Width_mm as "b - Width (mm)"
				c_Heigth_mm as "c - Heigth (mm)"
				Components
				Files_upload as "Files upload"
				Pcs_per_pack as "Pcs per pack"
				Product_Nr as "Product Nr."
				Image
			)
		}
		default list TPL_Liquids_Non_Pharma_Report
		{
			displayName = "TPL_Liquids_Non Pharma Reporte"
			show all rows from TPL_Liquids_Non_Pharma    
			(
				Product_Nr as "Product Nr."
				Liquid_Type as "Liquid Type"
				liquid_ph_level as "Liquid pH Level"
				leak_test_required as "Leak Test Required"
				liquid_density_g_ml as "Liquid Density"
				foaming_tendency as "Foaming Tendency"
				flash_point_c as "Flash Point"
				corrosiveness_level as "Corrosiveness Level"
				evaporation_rate as "Evaporation Rate"
				alcohol_content_percentage as "Alcohol Content Percentage"
				boiling_point_c as "Boiling Point"
				hazardous_material as "Hazardous Material"
				filling_temperature_c as "Filling Temperature"
				solvent_type as "Solvent Type"
				Product_Name as "Product Name"
				Image
			)
		}
		list Opportunity_Requirements_Report
		{
			displayName = "Opportunity_Requirements_Report"
			show all rows from Opportunity_Requirements    
			(
				Optionals_and_Accessories as "Notes and remarks"
				(
					foldcontent = enable
				)
				Products_month as "Products/month"
				Days_per_Month as "Days per Month"
				Shifts_day as "Shifts/day"
				Hours_per_shift as "Hours per shift"
				Products_hour as "Products/hour"
				Products_minute as "Products/ minute"
				compliance_Standards as "Compliance Standards"
				Conductors_Configuration as "Conductors Configuration"
				Electrical_Supply as "Electrical Supply"
				Neutral_Regime_Required as "Neutral Regime Required"
				Clean as "Cleaning system"
				Extent_of_Supply as "Extent of Supply"
				Validation_extent as "Validation Procedures | Documents"
				FDS_DQ as "FDS/DQ"
				IQ_OQ as "IQ/OQ"
				FAT
				SAT
				PQ
				Expected_Efficiency as "Expected Efficiency"
				Cleanroom_Sanitary_Requirements as "Cleanroom / Sanitary Requirements"
				Opportunity_Nr.Client_Company
				Opportunity_Nr.Client_Site as "Client Site:"
				Opportunity_Nr.Partner_Company as "Partner Company"
				(
					delimiter = comma
				)
				Opportunity_Nr.opportunity_owner as "Opportunity Owner"
				Opportunity_Nr.Quotation_Type as "Quotation Type:"
				Opportunity_Nr.Status as "Priority"
				Opportunity_Nr.Client_Industry as "Client Industry"
				Opportunity_Nr.Probability_of_getting_the_Order as "Probability of getting the Order"
				Opportunity_Nr.Opportunity_ID1 as "Opportunity ID"
				Added_Time as "Added Time"
				Product_Category.Number as "Product Category"
				Equipment_required.Machine_Type as "Equipment required"
			)
			filters
			(
				"Active Opportunity"  :  Opportunity_Nr.Opportunity_ID1 == "$Opp_ID"
			)
			custom actions
			(
				"Print Report"
				(
	  			workflow = Print_Requirements_Report
				show action in view header = true
				show action in edit record menu = true
				)
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Custom Requirements for board"
	 	  			content="<panel  \n >\n	<pr \n			width='fill'\n		height='fill'\n>\n	<pc \n		padding = '0px'\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n\n		width = '100%'\n		hAlign = 'center'\n		vAlign = 'middle'\n>\n	<pr \n			width='fill'\n		height='19.9916px'\n>\n	<pc \n		padding = '0px'\n	bgColor = '#F3F4F8'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n		width = '61%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = 'theme'\n	size = '12px'\n	bold = 'true' \n	type = 'Text'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Equipement Required'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '0px'\n	bgColor = '#F3F4F8'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n		width = '39%'\n		hAlign = 'left'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = 'theme'\n	size = '12px'\n	bold = 'true' \n	type = 'Text'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Accessories and notes'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='88px'\n>\n	<pc \n		padding = '17px'\n	bgColor = '#FFFFFF'\n\n    borderColor = '#F3F4F8'\n    borderWidth = '10px'\n		width = '59%'\n		hAlign = 'left'\n		vAlign = 'top'\n    	cornerRadius = '10px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#272727'\n	size = '15px'\n	fontFamily = 'lato, arimo, sans-serif' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '3'\n\n\