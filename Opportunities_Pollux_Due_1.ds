												specs = specs + "Dustiness Level: " + input.Dustiness_Level + "\n";
											}
											if(input.Oil_Content_Level != null && input.Oil_Content_Level.toString() != "")
											{
												specs = specs + "Oil Content Level: " + input.Oil_Content_Level + "\n";
											}
											if(input.Allergens != null && input.Allergens.toString() != "")
											{
												specs = specs + "Allergens: " + input.Allergens + "\n";
											}
											if(input.Target_Pack_Weight_g != null && input.Target_Pack_Weight_g.toString() != "")
											{
												specs = specs + "Target Pack Weight (g): " + input.Target_Pack_Weight_g + "\n";
											}
											if(input.Moisture != null && input.Moisture.toString() != "")
											{
												specs = specs + "Moisture (%): " + input.Moisture + "\n";
											}
											if(input.Product_Temp_Fill_C != null && input.Product_Temp_Fill_C.toString() != "")
											{
												specs = specs + "Product Temp Fill (C): " + input.Product_Temp_Fill_C + "\n";
											}
											if(input.Solids_Food_Options != null && input.Solids_Food_Options.size() > 0)
											{
												specs = specs + "Options: " + input.Solids_Food_Options.toString(", ") + "\n";
											}
										}
										input.Subtype = subtype;
										input.Specifications = specs.trim();
										// Vincula el producto al registro de Opportunity Requirements de la misma oportunidad
										if(input.New_Opportunity != null)
										{
											reqs = Opportunity_Requirements[Opportunity_Nr == input.New_Opportunity] sort by Added_Time desc;
											if(reqs.count() > 0)
											{
												input.Opportunity_Requirement = reqs.ID;
											}
										}
						)
					}
				}

			}
			Products_Show_fields_on_c as "Products - Show fields on category change"
			{
				type =  form
				form = Opportunity_Product_Specs

				record event = on add or edit

				on user input of Product_Category
				{
					actions 
					{
						custom deluge script
						(
											// Al cambiar Product Category: muestra solo los campos de esa categoria
										hide Alcohol_ABV;
										hide Product_Temp_Fill_C;
										hide Brix_deg;
										hide pH;
										hide Density_kg_L;
										hide Viscosity_cP;
										hide Flash_Point_C;
										hide Hazardous_Area_Zone;
										hide Inert_Gas_Type;
										hide Spirits_Options;
										hide Flat_Beverage_Type;
										hide Foaming_Level;
										hide Product_Contact_Material;
										hide Pulp_Content;
										hide Particle_Size_Max_mm;
										hide Flat_Beverage_Options;
										hide CO2_Volumes_Min;
										hide CO2_Volumes_Max;
										hide Filler_Bowl_Pressure_bar;
										hide Dissolved_Oxygen_Max_ppb;
										hide Pasteurization_Type;
										hide Carbonated_Options;
										hide Liquid_Type_Pharma;
										hide Osmolarity_mOsm_L;
										hide Regulatory_Classification;
										hide Liquid_Pharma_Options;
										hide Liquid_Type_Non_Pharma;
										hide Corrosiveness_Level;
										hide Evaporation_Rate;
										hide Boiling_Point_C;
										hide Solvent_Type;
										hide Liquid_Non_Pharma_Options;
										hide Semiliquid_Food_Type;
										hide Texture;
										hide Sugar_Content;
										hide Fat_Content;
										hide Non_Food_Semiliquid_Type;
										hide Rheology_Type;
										hide Stringiness_Level;
										hide Particle_Content;
										hide Semiliquid_Non_Food_Options;
										hide Dosage_Form;
										hide Unit_Weight_mg;
										hide Unit_Weight_Tolerance;
										hide Length_mm;
										hide Width_mm;
										hide Thickness_mm;
										hide Shape;
										hide Tablet_Hardness_N;
										hide Room_RH_Max;
										hide Vision_Inspection;
										hide Batch_Size_Min_kg;
										hide Batch_Size_Max_kg;
										hide Dustiness_Level;
										hide Solids_Pharma_Options;
										hide Solid_Food_Type;
										hide Piece_Weight_Max_g;
										hide Bulk_Density_kg_m3;
										hide Flowability;
										hide Fragility_Level;
										hide Stickiness_Level;
										hide Oil_Content_Level;
										hide Allergens;
										hide Target_Pack_Weight_g;
										hide Moisture;
										hide Solids_Food_Options;
										if(input.Product_Category == "Spirits-Liquors")
										{
											show Alcohol_ABV;
											show Product_Temp_Fill_C;
											show Brix_deg;
											show pH;
											show Density_kg_L;
											show Viscosity_cP;
											show Flash_Point_C;
											show Hazardous_Area_Zone;
											show Inert_Gas_Type;
											show Spirits_Options;
										}
										else if(input.Product_Category == "Flat Beverages")
										{
											show Flat_Beverage_Type;
											show Product_Temp_Fill_C;
											show Brix_deg;
											show pH;
											show Viscosity_cP;
											show Foaming_Level;
											show Product_Contact_Material;
											show Pulp_Content;
											show Particle_Size_Max_mm;
											show Flat_Beverage_Options;
										}
										else if(input.Product_Category == "Carbonated Beverages")
										{
											show CO2_Volumes_Min;
											show CO2_Volumes_Max;
											show Filler_Bowl_Pressure_bar;
											show Dissolved_Oxygen_Max_ppb;
											show Pasteurization_Type;
											show Brix_deg;
											show Product_Temp_Fill_C;
											show pH;
											show Foaming_Level;
											show Carbonated_Options;
										}
										else if(input.Product_Category == "Liquids - Pharma")
										{
											show Liquid_Type_Pharma;
											show Viscosity_cP;
											show Density_kg_L;
											show pH;
											show Osmolarity_mOsm_L;
											show Product_Temp_Fill_C;
											show Particle_Size_Max_mm;
											show Inert_Gas_Type;
											show Foaming_Level;
											show Regulatory_Classification;
											show Liquid_Pharma_Options;
										}
										else if(input.Product_Category == "Liquids - Non Pharma")
										{
											show Liquid_Type_Non_Pharma;
											show pH;
											show Density_kg_L;
											show Foaming_Level;
											show Flash_Point_C;
											show Corrosiveness_Level;
											show Evaporation_Rate;
											show Alcohol_ABV;
											show Boiling_Point_C;
											show Product_Temp_Fill_C;
											show Solvent_Type;
											show Liquid_Non_Pharma_Options;
										}
										else if(input.Product_Category == "Semiliquids - Food")
										{
											show Semiliquid_Food_Type;
											show Density_kg_L;
											show Texture;
											show Product_Temp_Fill_C;
											show Brix_deg;
											show Viscosity_cP;
											show Sugar_Content;
											show Fat_Content;
										}
										else if(input.Product_Category == "Semiliquids - Non Food")
										{
											show Non_Food_Semiliquid_Type;
											show Viscosity_cP;
											show Density_kg_L;
											show Product_Temp_Fill_C;
											show Rheology_Type;
											show Stringiness_Level;
											show Particle_Content;
											show Particle_Size_Max_mm;
											show Semiliquid_Non_Food_Options;
										}
										else if(input.Product_Category == "Solids - Pharma")
										{
											show Dosage_Form;
											show Unit_Weight_mg;
											show Unit_Weight_Tolerance;
											show Length_mm;
											show Width_mm;
											show Thickness_mm;
											show Shape;
											show Tablet_Hardness_N;
											show Room_RH_Max;
											show Vision_Inspection;
											show Batch_Size_Min_kg;
											show Batch_Size_Max_kg;
											show Dustiness_Level;
											show Solids_Pharma_Options;
										}
										else if(input.Product_Category == "Solids - Food")
										{
											show Solid_Food_Type;
											show Piece_Weight_Max_g;
											show Bulk_Density_kg_m3;
											show Flowability;
											show Fragility_Level;
											show Stickiness_Level;
											show Dustiness_Level;
											show Oil_Content_Level;
											show Allergens;
											show Target_Pack_Weight_g;
											show Moisture;
											show Product_Temp_Fill_C;
											show Solids_Food_Options;
										}
						)
					}
				}

			}
			Opportunity_Open_Board as "Opportunity - Open Board after save"
			{
				type =  form
				form = New_Opportunity

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Despues de guardar, abre el Opportunity Board de esta oportunidad
										openUrl("#Page:Opportunity_Board?Opp_ID=" + input.ID.toString(),"same window");
						)
					}
				}

			}
			Requirements_Return_to_Board as "Requirements - Return to Board after save"
			{
				type =  form
				form = Opportunity_Requirements

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Despues de guardar, regresa al Opportunity Board en la vista de Requirements de la misma oportunidad
										if(input.Opportunity_Nr != null)
										{
											openUrl("#Page:Opportunity_Board?Opp_ID=" + input.Opportunity_Nr.toString() + "&Board_Form=Requirements","same window");
										}
						)
					}
				}

			}
			Formats_Lock_Opportunity as "Formats - Lock Opportunity Link (Prefilled)"
			{
				type =  form
				form = Opportunity_Formats

				record event = on add or edit

				field rules
				{
					actions 
					{
						disable Format_Line;
					}
					actions  (New_Opportunity is not null)
					{
						disable New_Opportunity;
					}
				}

			}
			Formats_Number_Line as "Formats - Number format line"
			{
				type =  form
				form = Opportunity_Formats

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Numero consecutivo del formato dentro de la oportunidad (1, 2, 3...)
										input.Format_Line = Opportunity_Formats[New_Opportunity == input.New_Opportunity].count() + 1;
						)
					}
				}

			}
			Formats_Return_to_Board as "Formats - Return to Board after save"
			{
				type =  form
				form = Opportunity_Formats

				record event = on add or edit

				on success
				{
					actions 
