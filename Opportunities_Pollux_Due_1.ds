lorType = 'noFill'\n\n    borderColor = '#CBCBCB'\n    borderWidth = '0px'\n		width = '23%'\n		hAlign = 'center'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#2A70E7'\n	size = '15px'\n	bold = 'true' \n	fontFamily = 'lato, arimo, sans-serif' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '20'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#959595'\n    borderWidth = '0px'\n\n	  value = 'Overall_Completion_Status'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
