		default list Copy_of_Contacts_Clients_Report
		{
			displayName = "Copy of Contacts_Clients Report"
			show all rows from Copy_of_Contacts_Clients    
			(
				Name 
				Job_Title as "Job Title"
				Email_Id as "Email Id"
				Mobile_Number as "Mobile Number"
			)
		}
		default list All_Customer_Documents
		{
			displayName = "All Customer Documents"
			show all rows from Customer_documents    
			(
				document_title as "Document Title"
				issued_by  as "Issued By"
				document_type as "Document Type"
				document_status as "Document Status"
				document_version as "Document Version"
				document_file as "Document File"
