 application "Opportunities Pollux Due_1"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Bahia_Banderas"
 	time format = "24-hr"

 	forms
	{
		form Lead_Company
		{
			displayname = "Add Client Company"
			success message = "New Lead Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			Client_ID
			(
    			type = autonumber
				displayname = "Client ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Company_name
			(
    			type = text
				displayname = "Company name"
	 			row = 1
	 			column = 1   
				width = large
			)
			Website
			(
    			type = url
	 			row = 1
	 			column = 1   
				width = large
			)
			Employee_Count
			(
				type = picklist
				displayname = "Employee Count"
				values = {"< 100","100 - 500","500 - 1000","1000 - 10000","> 10000"}
	 			row = 1
	 			column = 2   
				width = medium
			)
			Industry
			(
				type = picklist
				maxchar = 100
				values = {"Pharma & Nutraceuticals","Cosmetics & Personal Care","Chemicals & Household","Food & Beverages"}
				sortorder = ascending
	 			row = 1
	 			column = 2   
				width = medium
			)
			Sitios
			(
				type = grid
				displayname = "Sites"
				values  = Client_Sites.ID
    			bidirectional = Lead_Company
	 			row = 2
	 			column = 1   
				width = medium
			)
			Contacts
			(
				type = grid
				values  = Contacts_Clients.ID
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Save
					(
   						type = submit
   						displayname = "Save"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
