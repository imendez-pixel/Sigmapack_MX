			Products_hour
			(
				type = decimal
				displayname = "Products/hour"
				format = commadotwestern
				decimalplace = 0
	 			row = 7
	 			column = 2   
				width = medium
    			Formula_Properties
    			(
    						value =  ((input.Products_month / input.Days_per_Month) / input.Shifts_day) / input.Hours_per_shift
    						visibility = true
    			)
			)
			Expected_Efficiency
			(
    			type = percentage
				displayname = "Expected Efficiency"
				initial value = 85%
				maxchar = 4
	 			row = 7
	 			column = 2   
				width = medium
			)
			Products_minute
			(
				type = decimal
				displayname = "Products/ minute"
	 			row = 7
	 			column = 2   
				width = medium
    			Formula_Properties
    			(
    						value =  (input.Products_month * 100.0) / (input.Days_per_Month * input.Shifts_day * input.Hours_per_shift * 60 * input.Expected_Efficiency)
    						visibility = true
    			)
			)
