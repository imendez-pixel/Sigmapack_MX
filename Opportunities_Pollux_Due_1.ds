>\n</pc><pc \n		padding = '0px'\n	bgColor = '#F3F4F8'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n		width = '25%'\n		hAlign = 'center'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = 'theme'\n	size = '12px'\n	bold = 'true' \n	type = 'Text'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Products/Hour'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '0px'\n	bgColor = '#F3F4F8'\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n		width = '29%'\n		hAlign = 'center'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = 'theme'\n	size = '12px'\n	bold = 'true' \n	type = 'Text'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Products/minute'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n			width='fill'\n		height='78.3565px'\n>\n	<pc \n		padding = '20px'\n	bgColor = '#FFFFFF'\n\n    borderColor = '#F3F4F8'\n    borderWidth = '10px'\n		width = '25%'\n		hAlign = 'center'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#184899'\n	size = '15px'\n	bold = 'true' \n	fontFamily = 'roboto-regular' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#00AD8C'\n    borderWidth = '0px'\n\n	  value = 'Products_month'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '20px'\n	bgColor = '#FFFFFF'\n\n    borderColor = '#F3F4F8'\n    borderWidth = '10px'\n		width = '20%'\n		hAlign = 'center'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#184899'\n	size = '15px'\n	bold = 'true' \n	fontFamily = 'roboto-regular' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Shifts_day'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '20px'\n	bgColor = '#FFFFFF'\n\n    borderColor = '#F3F4F8'\n    borderWidth = '10px'\n		width = '26%'\n		hAlign = 'center'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#184899'\n	size = '15px'\n	bold = 'true' \n	fontFamily = 'roboto-regular' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Products_hour'\n>\n</text>\n\n</pc>\n</pr>\n</pc><pc \n		padding = '20px'\n	bgColor = '#FFFFFF'\n\n    borderColor = '#F3F4F8'\n    borderWidth = '10px'\n		width = '29%'\n		hAlign = 'center'\n		vAlign = 'middle'\n    	cornerRadius = '0px'\n>\n	<pr \n			width='auto'\n		height='auto'\n>\n	<pc \n	\n>\n	<text \n\n	margin = '0px'\n	padding = '0px'\n	color = '#184899'\n	size = '15px'\n	bold = 'true' \n	fontFamily = 'roboto-regular' \n	type = 'field'\n\n	bgColor = 'transparent'\n        bgColorType = 'noFill'\n	cornerRadius = '0px'\n\n    lineHeight = '21'\n    numOfLines = '1'\n\n\n\n\n    borderColor = '#295BF9'\n    borderWidth = '0px'\n\n	  value = 'Products_minute'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>"
	    		)
