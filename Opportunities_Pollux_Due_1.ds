		}
		form Opportunity_Comments
		{
			displayname = "Opportunity Comments"
			success message = "Sent..."
			feature property = 192
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Opportunity
			(
				type = picklist	
				values  = New_Opportunity.ID
    			displayformat = [" - " + ID + " - " + Opportunity_ID1]
	 			row = 1
	 			column = 1   
				width = medium
			)
			Comment_Date_Time
			(
    			type = datetime
				displayname = "Comment Date Time"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm"
				alloweddays = 1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			Subject_field
			(
				type = picklist
				displayname = "Subject"
				maxchar = 100
				values = {"Requirements","Payment terms","Delivery","Discounts","Miscellaneous"}
				initial value = "Requirements"
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Section"
	 			row = 2
	 			column = 0   
				width = medium
			)
			Comments
			(
    			type = textarea
				height = 200px
	 			row = 2
	 			column = 1   
				width = large
			)
			Attachments
			(
    			type = upload file
    			file count = 5
				browse = local_drive, zoho_docs
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					Save
					(
   						type = submit
   						displayname = "Save"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Opportunity_Formats
		{
			displayname = "Opportunity Formats"
			success message = "Opportunity Format Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><span class=\"font\" style=\"font-family: Lato, sans-serif\"><span class=\"size\" style=\"font-size: 18.6667px\"><b><span class=\"colour\" style=\"color: rgb(255, 51, 51)\">Opportunity formats</span></b></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have New_Opportunity
			(
				type = picklist	
				values  = New_Opportunity.ID
    			displayformat = [Opportunity_ID1]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Format_Line
			(
				type = number
				displayname = "Format # (in this opportunity)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Format_Type
			(
				type = picklist
				displayname = "Format Type"
				maxchar = 100
				values = {"Unitary Packaging","Closure and capping","Labelling formats","Secondary Packaging","Tertiary Packaging","Pallet Specs"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Image
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Format_Name
			(
    			type = text
				displayname = "Format Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Unitary_Packaging_Type
			(
				type = picklist
				displayname = "Unitary Packaging Type"
				maxchar = 100
				values = {"Clamshell","Bag / pouch","Sachet / single-dose sachet","Stick pack","Flow pack","Blister pack","Thermoformed / blister tray","Plastic bottle","Glass bottle","Plastic jar","Glass jar","Jar / pot","Collapsible tube","Vial","Ampoule","Metal tin","Aerosol can","Doypack","Capsule","Sealed tray","Syringe glass","Syringe PE","Sealed cup"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Closure_Type
			(
				type = picklist
				displayname = "Closure Type"
				maxchar = 100
				values = {"Screwcap","Pilfer proof screwcap","Child Resistant","Flip top cap","ROPP Aluminium cap","Guala cap","Cork","Alu Sleeve","Mushroom cork - R.Galandrino","Crown cap","Twistoff Cap","Seamer"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Label_Type
			(
				type = picklist
				displayname = "Label Type"
				maxchar = 100
				values = {"Bottle","Self Adhesive labels","Shrink Sleeving","Hotmelt","Cold Glue","Wet glue","Rollfed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Secondary_Packaging_Type
			(
				type = picklist
				displayname = "Secondary Packaging Type"
				maxchar = 100
				values = {"Stand up Pouch","VFF&S pouch","Carton","Display trays","Overwrapping","Banding","Metal Can","Carton Can","Clamshell","Cardboard Sleeve","Ready to Display Box"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Tertiary_Packaging_Type
			(
				type = picklist
				displayname = "Tertiary Packaging Type"
				maxchar = 100
				values = {"RSC_Regular_Slotted_Container","Tray_Shrink_Wrap","Wraparound_Case","Display_Ready_Case","Partition_Case","Shrink_Multipack","Shrink_Tray","Stretch_Bundle","Plastic_Crate","Thermoform_Tray","Clip_Carrier","Ring_Carrier","Fiber_Carrier","Bulk_Bag_Liner","Gaylord_Box","Drum_Secondary","Cluster_Pack","Bag_in_Box_Carton"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Pallet_Standard
			(
				type = picklist
				displayname = "Pallet Standard"
				maxchar = 100
				values = {"GMA pallet (48\" x 40\")","Standard 48x48","42\" x 42\" Telecom-Retail","Europallet (1200 x 800)","Industrial (1200 x 1000)"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Primary_Material
			(
				type = picklist
				displayname = "Primary Material"
				maxchar = 100
				values = {"PET","rPET","HDPE / PEAD","LDPE / PEBD","PP","PVC","PS","PLA","BOPP","PET/PE laminate","Aluminum laminate","Paper","Paper-Laminate","Glass","Aluminium","Tin","Steel","Moulded pulp","SBS board","Kraft board","Micro-corrugated board","E-flute corrugated board","B-flute corrugated board","Corrugated cardboard","Paperboard","PET window","Cellophane","EVA / foam","LDPE shrink film","LLDPE stretch film","HDPE/PP crate","Plastic thermoform","Fiber molded","Synthetic labels","Laminated","Wood","Plastic","Fiber"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Quantity
			(
				type = number
				displayname = "Quantity (pcs)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Length_mm
			(
				type = number
				displayname = "Length (mm)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Width_mm
			(
				type = number
				displayname = "Width (mm)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Height_mm
			(
				type = number
				displayname = "Height (mm)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Diameter_mm
			(
				type = number
				displayname = "Diameter (mm)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Other_Features
			(
    			type = text
				displayname = "Other Features"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Size_mL_grs
			(
				type = number
				displayname = "Size (mL | grs)"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Neck_Diameter_mm
