			Formats_Set_Subtype_on_su as "Formats - Set Subtype on submit"
			{
				type =  form
				form = Opportunity_Formats

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Guarda el subtipo y arma el resumen de datos adicionales (solo campos capturados)
										details = "";
										if(input.Format_Type == "Unitary Packaging")
										{
											input.Subtype = input.Unitary_Packaging_Type;
											if(input.Size_mL_grs != null && input.Size_mL_grs.toString() != "")
											{
												details = details + "Size (mL/grs): " + input.Size_mL_grs + "\n";
											}
											if(input.Neck_Diameter_mm != null && input.Neck_Diameter_mm.toString() != "")
											{
												details = details + "Neck Diameter (mm): " + input.Neck_Diameter_mm + "\n";
											}
										}
										else if(input.Format_Type == "Closure and capping")
										{
											input.Subtype = input.Closure_Type;
										}
										else if(input.Format_Type == "Labelling formats")
										{
											input.Subtype = input.Label_Type;
											if(input.Label_Placement != null && input.Label_Placement.toString() != "")
											{
												details = details + "Label Placement: " + input.Label_Placement + "\n";
											}
											if(input.Label_Gauge_mm_in_1k != null && input.Label_Gauge_mm_in_1k.toString() != "")
											{
												details = details + "Label Gauge (mm)-(in/1k): " + input.Label_Gauge_mm_in_1k + "\n";
											}
											if(input.Tax_Stamp != null && input.Tax_Stamp.size() > 0)
											{
												details = details + "Tax Stamp: " + input.Tax_Stamp.toString(", ") + "\n";
											}
											if(input.Label_Options != null && input.Label_Options.size() > 0)
											{
												details = details + "Label Inspection: " + input.Label_Options.toString(", ") + "\n";
											}
										}
										else if(input.Format_Type == "Secondary Packaging")
										{
											input.Subtype = input.Secondary_Packaging_Type;
											if(input.Components != null && input.Components.toString() != "")
											{
												details = details + "Components: " + input.Components + "\n";
											}
										}
										else if(input.Format_Type == "Tertiary Packaging")
										{
											input.Subtype = input.Tertiary_Packaging_Type;
											if(input.Array != null && input.Array.toString() != "")
											{
												details = details + "Array: " + input.Array + "\n";
											}
											if(input.Board_Grade != null && input.Board_Grade.toString() != "")
											{
												details = details + "Board Grade: " + input.Board_Grade + "\n";
											}
											if(input.Case_Closure_Type != null && input.Case_Closure_Type.toString() != "")
											{
												details = details + "Case Closure: " + input.Case_Closure_Type + "\n";
											}
											if(input.Shrink_Film_Gauge_micron != null && input.Shrink_Film_Gauge_micron.toString() != "")
											{
												details = details + "Shrink Film Gauge (micron): " + input.Shrink_Film_Gauge_micron + "\n";
											}
										}
										else if(input.Format_Type == "Pallet Specs")
										{
											input.Subtype = input.Pallet_Standard;
											if(input.Layers_per_Pallet != null && input.Layers_per_Pallet.toString() != "")
											{
												details = details + "Layers per Pallet: " + input.Layers_per_Pallet + "\n";
											}
											if(input.Units_per_Layer != null && input.Units_per_Layer.toString() != "")
											{
												details = details + "Units per Layer: " + input.Units_per_Layer + "\n";
											}
											if(input.Pallet_Height_mm != null && input.Pallet_Height_mm.toString() != "")
											{
												details = details + "Pallet Height (mm): " + input.Pallet_Height_mm + "\n";
											}
											if(input.Max_Pallet_Weight_kg != null && input.Max_Pallet_Weight_kg.toString() != "")
											{
												details = details + "Max Pallet Weight (kg): " + input.Max_Pallet_Weight_kg + "\n";
											}
											if(input.Pallet_Options != null && input.Pallet_Options.size() > 0)
											{
												details = details + "Pallet Options: " + input.Pallet_Options.toString(", ") + "\n";
											}
										}
										if(input.Diameter_mm != null && input.Diameter_mm.toString() != "")
										{
											details = details + "Diameter (mm): " + input.Diameter_mm + "\n";
										}
										if(input.Weight_kg != null && input.Weight_kg.toString() != "")
										{
											details = details + "Weight (kg): " + input.Weight_kg + "\n";
										}
										if(input.Other_Features != null && input.Other_Features.toString() != "")
										{
											details = details + "Other Features: " + input.Other_Features + "\n";
										}
										input.Format_Details = details.trim();
										// Vincula el formato al registro de Opportunity Requirements de la misma oportunidad
										if(input.New_Opportunity != null)
										{
											reqs = Opportunity_Requirements[Opportunity_Nr == input.New_Opportunity] sort by Added_Time desc;
											if(reqs.count() > 0)
											{
												input.Opportunity_Requirement = reqs.ID;
											}
										}
						)
					}
				}

			}
			Requirements_Link_Opportu as "Requirements - Link Opportunity Formats"
			{
				type =  form
				form = Opportunity_Requirements

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Vincula los formatos y productos de la oportunidad a este registro de requerimientos
										if(input.Opportunity_Nr != null)
										{
											for each  fmt in Opportunity_Formats[New_Opportunity == input.Opportunity_Nr && Opportunity_Requirement == null]
											{
												fmt.Opportunity_Requirement=input.ID;
											}
											for each  prd in Opportunity_Product_Specs[New_Opportunity == input.Opportunity_Nr && Opportunity_Requirement == null]
											{
												prd.Opportunity_Requirement=input.ID;
											}
										}
						)
					}
				}

			}
			Products_Show_fields_by_c as "Products - Show fields by category on load"
			{
				type =  form
				form = Opportunity_Product_Specs

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Los datos de producto se capturan a nivel principal.
										// El resumen, subtipo y vinculo se calculan al enviar el formulario.
										hide Subtype;
										hide Specifications;
										hide Opportunity_Requirement;
										// Muestra solo los campos de la categoria seleccionada
										hide Alcohol_ABV;
										hide Product_Temp_Fill_C;
										hide Brix_deg;
										hide pH;
										hide Density_kg_L;
										hide Viscosity_cP;
										hide Flash_Point_C;
										hide Hazardous_Area_Zone;
										hide Inert_Gas_Type;
										hide Spirits_Options;
										hide Flat_Beverage_Type;
										hide Foaming_Level;
										hide Product_Contact_Material;
										hide Pulp_Content;
										hide Particle_Size_Max_mm;
										hide Flat_Beverage_Options;
										hide CO2_Volumes_Min;
										hide CO2_Volumes_Max;
										hide Filler_Bowl_Pressure_bar;
										hide Dissolved_Oxygen_Max_ppb;
										hide Pasteurization_Type;
										hide Carbonated_Options;
										hide Liquid_Type_Pharma;
										hide Osmolarity_mOsm_L;
										hide Regulatory_Classification;
										hide Liquid_Pharma_Options;
										hide Liquid_Type_Non_Pharma;
										hide Corrosiveness_Level;
										hide Evaporation_Rate;
										hide Boiling_Point_C;
										hide Solvent_Type;
										hide Liquid_Non_Pharma_Options;
										hide Semiliquid_Food_Type;
										hide Texture;
										hide Sugar_Content;
										hide Fat_Content;
										hide Non_Food_Semiliquid_Type;
										hide Rheology_Type;
										hide Stringiness_Level;
										hide Particle_Content;
										hide Semiliquid_Non_Food_Options;
										hide Dosage_Form;
										hide Unit_Weight_mg;
										hide Unit_Weight_Tolerance;
										hide Length_mm;
										hide Width_mm;
										hide Thickness_mm;
										hide Shape;
										hide Tablet_Hardness_N;
										hide Room_RH_Max;
										hide Vision_Inspection;
										hide Batch_Size_Min_kg;
										hide Batch_Size_Max_kg;
										hide Dustiness_Level;
										hide Solids_Pharma_Options;
										hide Solid_Food_Type;
										hide Piece_Weight_Max_g;
										hide Bulk_Density_kg_m3;
										hide Flowability;
										hide Fragility_Level;
										hide Stickiness_Level;
										hide Oil_Content_Level;
										hide Allergens;
										hide Target_Pack_Weight_g;
										hide Moisture;
										hide Solids_Food_Options;
										if(input.Product_Category == "Spirits-Liquors")
										{
											show Alcohol_ABV;
											show Product_Temp_Fill_C;
											show Brix_deg;
											show pH;
											show Density_kg_L;
											show Viscosity_cP;
											show Flash_Point_C;
											show Hazardous_Area_Zone;
											show Inert_Gas_Type;
											show Spirits_Options;
										}
										else if(input.Product_Category == "Flat Beverages")
										{
											show Flat_Beverage_Type;
											show Product_Temp_Fill_C;
											show Brix_deg;
