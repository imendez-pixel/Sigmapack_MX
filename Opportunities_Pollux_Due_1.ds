t'\n            bgColorType = 'noFill'\n\t\tcornerRadius = '0px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\t%&gt;\n&lt;style&gt;\n.zcpage-elemContainer:has(.zc-pb-formreport-placeholder[formlinkname=&quot;Opportunity_Requirements&quot;]),\n.zcpage-elemContainer:has(.zc-pb-formreport-placeholder[formlinkname=&quot;Opportunity_Products&quot;]),\n.zcpage-elemContainer:has(.zc-pb-formreport-placeholder[formlinkname=&quot;Opportunity_Formats&quot;]) {\n    display: none !important;\n}\n&lt;/style&gt;\n&lt;%\n\tif(input.Opp_ID != null &amp;&amp; input.Opp_ID &gt; 0)\n\t{\n\t\tif(input.Board_Form == &quot;Requirements&quot;)\n\t\t{\n\t\t\tactiveRequirements = Opportunity_Requirements[Opportunity_Nr == input.Opp_ID] sort by Added_Time desc;\n\t\t\tif(activeRequirements.count() &gt; 0)\n\t\t\t{\n\t\t\t\tfor each  requirementRecord in activeRequirements\n\t\t\t\t{\n\t\t\t\t\t%&gt;\n&lt;div elName=&quot;zc-component&quot; formLinkName=&quot;Opportunity_Requirements&quot; params=&quot;recLinkID=&lt;%=requirementRecord.ID%&gt;&amp;viewLinkName=Opportunity_Requirements_Report&amp;zc_Header=false&amp;zc_Focus=false&quot;&gt;Loading requirements...&lt;/div&gt;\n&lt;%\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\t%&gt;\n&lt;div elName=&quot;zc-component&quot; formLinkName=&quot;Opportunity_Requirements&quot; params=&quot;Opportunity_Nr=&lt;%=input.Opp_ID%&gt;&amp;zc_Header=false&amp;zc_Focus=false&quot;&gt;Loading requirements...&lt;/div&gt;\n&lt;%\n\t\t\t}\n\t\t}\n\t\telse if(input.Board_Form == &quot;Products&quot;)\n\t\t{\n\t\t\tproductCount = Opportunity_Product_Specs[New_Opportunity == input.Opp_ID].count();\n\t\t\t%&gt;\n&lt;div style=&quot;padding:12px 16px 4px 16px;font-family:lato, arimo, sans-serif;&quot;&gt;&lt;div style=&quot;color:#C00000;font-size:18px;font-weight:bold;&quot;&gt;Products in this opportunity: &lt;%=productCount%&gt;&lt;/div&gt;&lt;div style=&quot;color:#5D6D7E;font-size:13px;margin-top:4px;&quot;&gt;Fill in the form and click Save. The form will be ready again for the next product, which will be Product #&lt;%=productCount + 1%&gt;. The list below shows every product captured.&lt;/div&gt;&lt;/div&gt;\n&lt;div elName=&quot;zc-component&quot; formLinkName=&quot;Opportunity_Product_Specs&quot; params=&quot;New_Opportunity=&lt;%=input.Opp_ID%&gt;&amp;zc_Header=false&amp;zc_Focus=false&quot;&gt;Loading product specs...&lt;/div&gt;\n&lt;div style=&quot;height:16px;&quot;&gt;&lt;/div&gt;\n&lt;div elName=&quot;zc-component&quot; viewLinkName=&quot;All_Opportunity_Product_Specs&quot; params=&quot;New_Opportunity=&lt;%=input.Opp_ID%&gt;&amp;zc_Header=true&quot;&gt;Loading products...&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse if(input.Board_Form == &quot;Formats&quot;)\n\t\t{\n\t\t\tformatCount = Opportunity_Formats[New_Opportunity == input.Opp_ID].count();\n\t\t\t%&gt;\n&lt;div style=&quot;padding:12px 16px 4px 16px;font-family:lato, arimo, sans-serif;&quot;&gt;&lt;div style=&quot;color:#C00000;font-size:18px;font-weight:bold;&quot;&gt;Formats in this opportunity: &lt;%=formatCount%&gt;&lt;/div&gt;&lt;div style=&quot;color:#5D6D7E;font-size:13px;margin-top:4px;&quot;&gt;Fill in the form and click Save. The form will be ready again for the next format, which will be Format #&lt;%=formatCount + 1%&gt;. The list below shows every format captured.&lt;/div&gt;&lt;/div&gt;\n&lt;div elName=&quot;zc-component&quot; formLinkName=&quot;Opportunity_Formats&quot; params=&quot;New_Opportunity=&lt;%=input.Opp_ID%&gt;&amp;zc_Header=false&amp;zc_Focus=false&quot;&gt;Loading formats...&lt;/div&gt;\n&lt;div style=&quot;height:16px;&quot;&gt;&lt;/div&gt;\n&lt;div elName=&quot;zc-component&quot; viewLinkName=&quot;All_Opportunity_Formats&quot; params=&quot;New_Opportunity=&lt;%=input.Opp_ID%&gt;&amp;zc_Header=true&quot;&gt;Loading formats...&lt;/div&gt;\n&lt;%\n\t\t}\n\t\telse\n\t\t{\n\t\t\t%&gt;\n&lt;div elName=&quot;zc-component&quot; formLinkName=&quot;New_Opportunity&quot; params=&quot;recLinkID=&lt;%=input.Opp_ID%&gt;&amp;viewLinkName=New_All_Opportunites_Report&amp;zc_Header=false&quot;&gt;Loading opportunity...&lt;/div&gt;\n&lt;%\n\t\t}\n\t}\n\telse\n\t{\n\t\t%&gt;\n&lt;div style=&quot;padding:24px;&quot;&gt;Selecciona una oportunidad en New All Opportunites Report para editarla.&lt;/div&gt;\n&lt;%\n\t}\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				if(input.Opp_ID == null)
				{
					input.Opp_ID = 0;
				}
				if(input.Opp_ID > 0)
				{
					statusList = New_Opportunity[ID == input.Opp_ID].Overall_Completion_Status;
					if(statusList != null)
					{
						input.Opp_Status = statusList;
					}
					reqId = Opportunity_Requirements[Opportunity_Nr == input.Opp_ID].ID sort by Added_Time desc;
					if(reqId != null)
					{
						input.Req_ID = reqId;
					}
				}
			}
		}
		page Quotations_and_Documents2(int ClientCompanyID, int Opp_ID, string OpportunityID)
		{
			displayname = "Quotations and Documents Hub"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgtype = 'gallery'\n\tbgColor = '#474757'\n\tbgImageRepeat = 'no-repeat'\n\tbgImagePosition = 'fit'\n\tbgHorizontalAlign = 'left'\n\tbgVerticalAlign = 'center'\n\tbgImage = 'logo_white__1_.png'\n\n    borderColor = '#474757'\n    borderWidth = '10px'\n\t\twidth = '23%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '0px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t\n</pc>\n</pr>\n</pc><pc \n\t\tpadding = '0px'\n\tbgColor = '#474757'\n\n    borderColor = '#222326'\n    borderWidth = '0px'\n\t\twidth = '77%'\n\t\thAlign = 'right'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '0px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '10px'\n\tpadding = '10px'\n\tcolor = '#FF4C2F'\n\tsize = '20px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = 'Quotations and documents Hub'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='57%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '0px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n    borderColor = '#222326'\n    borderWidth = '0px'\n\t\thAlign = 'left'\n    \tcornerRadius = '0px'\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#333333'\n    borderWidth = '0px'\n\n\t  value = 'Active Opportunity:'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n    action = 'ExecuteFunction'\n\n\t\tparameters = '${Opp_ID}' \n\t\tfunctionName = 'getActiveOpportunityText'  \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '0px'\n\tmarginTop = '2px'\n\tpadding = '0px'\n\tcolor = '#FF4C2F'\n\tsize = '20px'\n\tbold = 'true' \n\ttype = 'variable'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#FF4C2F'\n    borderWidth = '0px'\n\n\t  value = '${OpportunityID}'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column><column\n   \t\t width='43%'\n   \t>\n\t<search \n\telementName='Search'\n\tpaddingTop = '10px'\n\tpaddingLeft = '10px'\n\tpaddingRight = '10px'\n\tpaddingBottom = '10px'\n\tbgtype = 'none'\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\n\tshape = 'flat'\n\tresultComponent = 'report'\n\tlinkName = 'New_All_Opportunites_Report'\n\ttarget = 'new-window'\n\tcriteriaString = 'Client_Company.Company_name.contains(input.searchString)'\n\tfontFamily = 'default'\n\tappLinkName = 'thisapp'\n\tstyle = '2'\n\tplaceholder = 'Enter value'\n\n>\n<searchbar color=\"#000000\" bgColor=\"#FFFFFF\" fontSize=\"15px\"\n/><searchbutton color=\"#FFFFFF\" bgColor=\"#0072F4\" \nfontSize=\"15px\"  /></search>\n</column>\n</row><row>\n\t<column\n   \t\t width='69%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 2'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenForm'\n\t\tparameters = 'Opportunity_Nr=${Opp_ID}&amp;Client_Company=${ClientCompanyID}' \n\t\tcomponentLinkName = 'Add_Update_Quotation'\n\t\ttarget = 'popup'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='+ Nueva Cotizaci\u00F3n'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '60px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Add_Update_Quotation_Report'\n\t\tcriteriaString = 'Opportunity_Nr.ID == input.Opp_ID'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_DelRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 3'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenForm'\n\t\tparameters = 'Opportunity_Nr=${Opp_ID}&amp;Client_Company=${ClientCompanyID}' \n\t\tcomponentLinkName = 'Add_Update_Documents'\n\t\ttarget = 'popup'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='+ Nuevo Documento'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '60px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Add_Documents_Report'\n\t\tallowPublicAccess = 'true'\n\t\tcriteriaString = 'Opportunity_Nr.ID == input.Opp_ID'\n\t\n\t\tiszreport = 'false'\n\t\t\t\t\tzc_AddRec = 'false'\n\t\t\t\t\tzc_DuplRec = 'false'\n\t\t\t\t\tzc_EditBulkRec = 'false'\n\t\t\t\t\tzc_BulkDelete = 'false'\n\t\t\t\t\tzc_BulkDuplicate = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row>\n</column><column\n   \t\t width='31%'\n   \t>\n\t<widgets elementName='Widget' importedTemplate='true'/>\n</column>\n</row>\n</layout>\n</zml>"
			script
			{
				oppInfo = New_Opportunity[ID == input.Opp_ID];
				if(oppInfo.count() > 0)
				{
					input.ClientCompanyID = oppInfo.Client_Company;
					input.OpportunityID = oppInfo.Opportunity_ID1;
				}
			}
		}
	}


		 functions
		 {
			 Deluge
			 {
				 string getActiveOpportunityText(int active_opportunity_id)
                 {
                 	// Fetch the record from New_Opportunity form using the provided ID
                 	opportunityRecord = New_Opportunity[ID == active_opportunity_id];
                 	// Check if a record was found
                 	if(opportunityRecord.count() > 0)
                 	{
                 		// Get the Opportunity_ID_Text field value from the first matching record
                 		result = opportunityRecord.Opportunity_ID_Text;
                 	}
                 	else
                 	{
                 		// Return empty string if no record found
                 		result = "";
                 	}
                 	return result;
                 }
				 void openRequirementsDetail(int opportunityId)
                 {
                 	if(opportunityId != null && opportunityId != 0)
                 	{
                 		reqId = Opportunity_Requirements[Opportunity_Nr == opportunityId].ID sort by Added_Time desc;
                 		if(reqId != null)
                 		{
                 			openUrl("https://creatorapp.zoho.com/imendez_sigmapack/opportunities-pollux-due-1/record-summary/Opportunity_Requirements_Report/" + reqId.toString() + "/","popup window");
                 		}
                 	}
                 }
			 }
		 }


		workflow
		{
		form
		{
			Submission_mode as "Submission mode"
			{
				type =  form
				form = New_Opportunity

				record event = on add or edit

				field rules
				{
					actions 
					{
						disable Username,Password;
					}
					actions  (Online_Bidding_through_customer_portal == "Online Bidding through customer portal")
					{
						enable Password,Username;
					}
				}

			}
			Capture_Active_Opportunity_ID as "Capture Active Opportunity ID"
			{
				type =  form
				form = New_Opportunity

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Get the current record ID from the New_Opportunity form
										active_Opportunity_ID = input.ID;
										// Store it in a variable for use in subsequent logic
										active_Opportunity = active_Opportunity_ID;
						)
					}
				}

			}
			Refresh_Completion_New_Opportunity as "Refresh Completion - Opportunity"
			{
				type =  form
				form = New_Opportunity

				record event = on add or edit
					status = inactive

				on success
				{
				}

			}
			Refresh_Completion_Requirements as "Refresh Completion - Requirements"
			{
				type =  form
				form = Opportunity_Requirements

				record event = on add or edit

				on success
				{
				}

			}
			Create_ID as "Create ID"
			{
				type =  form
				form = New_Opportunity

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											oppRecord = New_Opportunity[ID == input.ID];
										seqNum = oppRecord.Opportunity_Seq;
										seqText = seqNum.toString();
										if(seqNum < 99)
										{
											seqText = "0" + seqText;
										}
										yy = zoho.currentdate.toString("yy");
										mm = zoho.currentdate.toString("MM");
										clienteName = "";
										if(oppRecord.Client_Company != null)
										{
											clienteName = oppRecord.Client_Company.Company_name;
										}
										partnerName = "";
										if(oppRecord.Partner_Company != null)
										{
											partnerName = oppRecord.Partner_Company.Partner_Company_name;
										}
										refText = oppRecord.Solution_Requested;
										codeText = "Q" + yy + mm + "-" + seqText + "-" + clienteName + "-" + partnerName + "-" + refText;
										oppRecord.Opportunity_ID1=codeText;
										oppRecord.Opportunity_ID_Text="<b><span style='font-size:14px; color:#295bf9;'>" + codeText + "</span></b>";
						)
					}
				}

			}
