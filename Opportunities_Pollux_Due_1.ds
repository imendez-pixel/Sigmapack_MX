		custom Opportunity_comments_report
		{
			displayName = "Opportunity comments report"
			show all rows from Opportunity_Comments    
			(
				Comment_Date_Time as "Comment Date Time"
				Comments
				Attachments
				Added_User as "Added User"
				Modified_User as "Modified User"
				Subject_field as "Subject"
				Opportunity.Opportunity_ID1 as "Opportunity ID"
			)
		}
		custom Copy_of_Opportunity_Information
		{
			displayName = "Opportunity Basic Information"
			show all rows from New_Opportunity    
			(
				Opportunity_ID1 as "Opportunity ID"
				Opportunity_ID_Text
				(
					displayformat = plaintext
					foldcontent = enable
				)
				Username as "Username:"
				Password as "Password:"
				Upload_Files as "Upload Files"
				Overall_Completion_Status as "Completion status"
				State
				Form_status as "Form Status"
			)
			custom actions
			(
				"Open Opportunity  Board"
				(
	  			workflow = Open_Opportunity_Board
				show action in edit record menu = true
				)
			)
			conditional formatting
			(
				"New Formatting"
				{
				condition = (Opportunity_ID1 is not null)
				fields = [Opportunity_ID1]
				format = "font-weight:bold;color:#398ef3;"
				}
				"New Formatting"
				{
				condition = (State == "Concluded")
				fields = [State]
				format = "font-weight:bold;color:#e64d3b;"
				}
				"New Formatting"
				{
				condition = (State == "On Going")
				fields = [State]
				format = "color:#19bc9f;"
				}
			)
			customlayouts
			(
				template
	 			(
	 	  			displayname="Opportunity Information"
