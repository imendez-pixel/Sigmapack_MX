			Run_Scripts_On_Always1 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Sales

				record event = on add or edit

				on add row of Add_Items
				{
					actions 
					{
						custom deluge script
						(
											//Autogenerate serial numbers and products list in subform for each row
										count_var = 0;
										productsList = {"Product - 1","Product - 2","Product - 3"};
										for each  item in input.Add_Items
										{
											productsList.removeElement(item.Item_Name);
											count_var = count_var + 1;
										}
										row.Item_Name:ui.add(productsList);
										row.S_No=count_var;
						)
					}
				}

			}
			Run_Scripts_On_Always2 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Sales

				record event = on add or edit

				on delete row of Add_Items
				{
					actions 
					{
						custom deluge script
						(
											//Regenerate serial number on deletion of a product 
										for each  item in input.Add_Items
										{
											if(item.S_No > row.S_No)
											{
												item.S_No=item.S_No - 1;
											}
										}
										//Recalculate total amount on deletion of a product 
										input.Total_Amount_to_be_Paid = input.Total_Amount_to_be_Paid - row.Total_Cost;
						)
					}
				}

			}
			Run_Scripts_On_Always3 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Sales

				record event = on add or edit

				on user input of Add_Items.Item_Name
				{
					actions 
					{
						custom deluge script
						(
											//Defining price for the given products
										if(row.Item_Name == "Product - 1")
										{
											row.Unit_Price=20;
										}
										else if(row.Item_Name == "Product - 2")
										{
											row.Unit_Price=50;
										}
										else if(row.Item_Name == "Product - 3")
										{
											row.Unit_Price=100;
										}
						)
					}
				}

			}
			Run_Scripts_On_Always4 as "Run Scripts - On Always"
			{
				type =  form
				form = Add_Sales

				record event = on add or edit

				on user input of Add_Items.Quantity
				{
					actions 
					{
						custom deluge script
						(
											//Autocalculate total cost of the product
										if(row.Quantity != null && row.Unit_Price != null)
										{
											row.Total_Cost=row.Unit_Price * row.Quantity;
										}
										//Autocalculate total bill amount
										input.Total_Amount_to_be_Paid = 0.0;
										for each  item in input.Add_Items
										{
											input.Total_Amount_to_be_Paid = input.Total_Amount_to_be_Paid + item.Total_Cost;
										}
						)
					}
				}

			}
			Formats_Show_fields_by_ty as "Formats - Show fields by type on load"
			{
				type =  form
				form = Opportunity_Formats

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Oculta todos los campos específicos por tipo
										hide Format_Details;
										hide Unitary_Packaging_Type;
										hide Size_mL_grs;
										hide Neck_Diameter_mm;
										hide Closure_Type;
										hide Label_Type;
										hide Label_Placement;
										hide Label_Gauge_mm_in_1k;
										hide Tax_Stamp;
										hide Label_Options;
										hide Secondary_Packaging_Type;
										hide Components;
										hide Tertiary_Packaging_Type;
										hide Array;
										hide Board_Grade;
										hide Case_Closure_Type;
										hide Shrink_Film_Gauge_micron;
										hide Pallet_Standard;
										hide Layers_per_Pallet;
										hide Units_per_Layer;
										hide Pallet_Height_mm;
										hide Max_Pallet_Weight_kg;
										hide Pallet_Options;
										hide Subtype;
										hide Opportunity_Requirement;
										// Muestra solo los del tipo seleccionado
										if(input.Format_Type == "Unitary Packaging")
										{
											show Unitary_Packaging_Type;
											show Size_mL_grs;
											show Neck_Diameter_mm;
										}
										else if(input.Format_Type == "Closure and capping")
										{
											show Closure_Type;
										}
										else if(input.Format_Type == "Labelling formats")
										{
											show Label_Type;
											show Label_Placement;
											show Label_Gauge_mm_in_1k;
											show Tax_Stamp;
											show Label_Options;
										}
										else if(input.Format_Type == "Secondary Packaging")
										{
											show Secondary_Packaging_Type;
											show Components;
										}
										else if(input.Format_Type == "Tertiary Packaging")
										{
											show Tertiary_Packaging_Type;
											show Array;
											show Board_Grade;
											show Case_Closure_Type;
											show Shrink_Film_Gauge_micron;
										}
										else if(input.Format_Type == "Pallet Specs")
										{
											show Pallet_Standard;
											show Layers_per_Pallet;
											show Units_per_Layer;
											show Pallet_Height_mm;
											show Max_Pallet_Weight_kg;
											show Pallet_Options;
										}
						)
					}
				}

			}
