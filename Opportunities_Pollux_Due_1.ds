						disable New_Opportunity;
					}
				}

			}
			Products_Number_Line as "Products - Number product line"
			{
				type =  form
				form = Opportunity_Product_Specs

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Numero consecutivo del producto dentro de la oportunidad (1, 2, 3...)
										input.Product_Line = Opportunity_Product_Specs[New_Opportunity == input.New_Opportunity].count() + 1;
						)
					}
				}

			}
