						custom deluge script
						(
											// Despues de guardar, regresa al Opportunity Board en la vista de Formats de la misma oportunidad
										if(input.New_Opportunity != null)
										{
											openUrl("#Page:Opportunity_Board?Opp_ID=" + input.New_Opportunity.toString() + "&Board_Form=Formats","same window");
										}
						)
					}
				}

			}
			Products_Lock_Opportunity as "Products - Lock Opportunity Link (Prefilled)"
			{
				type =  form
				form = Opportunity_Product_Specs

				record event = on add or edit

				field rules
				{
					actions 
