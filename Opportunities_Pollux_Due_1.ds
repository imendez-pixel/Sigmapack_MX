			{
				on add
				{
					Save
					(
   						type = submit
   						displayname = "Save"
					)
					Cancel1
					(
   						type = reset
   						displayname = "Cancel"
					)
				}
				on edit
				{
					Save1
					(
   						type = submit
   						displayname = "Save"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Opportunity_Product_Specs
		{
			displayname = "Opportunity Product Specs"
			success message = ""
			feature property = 512
			Section1
			(
				type = section
				displayname = "Section"
	 			row = 1
	 			column = 0   
				width = medium
			)
			plain
			(
    			type = plaintext
				value = "<div><span class=\"font\" style=\"font-family: Lato, sans-serif\"><span class=\"size\" style=\"font-size: 18.6667px\"><span class=\"colour\" style=\"color: rgb(255, 51, 51)\">Opportunity Products</span></span></span><br /></div>"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have New_Opportunity
			(
				type = picklist	
				displayname = "Opportunity"
				values  = New_Opportunity.ID
    			displayformat = [Opportunity_ID1]
				allow new entries
				[
					displayname = "Agregar nuevo"
				]
	 			row = 2
	 			column = 1   
				width = medium
			)
			Form_Status
			(
				type = radiobuttons
				displayname = "Form Status"
				maxchar = 100
				values = {"Draft","Completed"}
				initial value = "Draft"
				others option = true
	 			row = 2
	 			column = 2   
				width = medium
			)
			Product_Line
			(
				type = number
				displayname = "Product # (in this opportunity)"
	 			row = 2
	 			column = 2   
				width = medium
